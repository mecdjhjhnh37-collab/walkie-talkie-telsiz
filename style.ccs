* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    background: #101820;
    color: white;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
}

.container {
    width: 90%;
    max-width: 420px;
    text-align: center;
}

h1 {
    margin-bottom: 25px;
    font-size: 30px;
}

.buttons {
    display: flex;
    gap: 15px;
    justify-content: center;
    margin-bottom: 20px;
}

button {
    background: #00a8ff;
    color: white;
    border: none;
    padding: 15px 20px;
    border-radius: 15px;
    font-size: 16px;
    cursor: pointer;
}

button:hover {
    background: #0088cc;
}

.box {
    background: #1b2735;
    border-radius: 20px;
    padding: 20px;
    margin-top: 15px;
    min-height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
}

#camera {
    width: 100%;
    border-radius: 15px;
}

#status {
    margin-top: 20px;
    color: #00ff99;
    font-size: 18px;
}
